<div class="mt-3">
  {%- for tag in post.data.tags or tags -%} {% if (loop.index <= 4) %} {% if tag !== 'posts' %} {%-
  set tagUrl -%}/blog/categories/{{ tag | slug }}/{%- endset -%}
  <a
    href="{{ tagUrl }}"
    title="{{ tag }}"
    class="mr-4 mb-2 inline-block mt-2 rounded border-2 bg-surfaceTag font-semibold font-ui text-textBody hover:text-textAccent px-3 py-1 text-xl border-borderSubtle cursor-pointer hover:border-borderStrong transition-colors"
  >
    {{ tag | lower }}
  </a>
  {% endif %} {% endif %} {% endfor %}
</div>
