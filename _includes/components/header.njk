<div>
  <nav class="bg-surface border-b border-borderSubtle" role="navigation">
    <div class="w-full md:max-w-6xl mx-auto py-4 px-4">
      <div class="flex items-center justify-between h-16">
        <!-- Logo on the left -->
        <div class="flex-shrink-0">
          <a href="/" class="flex items-center">
            <img class="h-12 w-12" src="/images/theme/new_logo.svg" alt="Geshan G" />
          </a>
        </div>

        <!-- Navigation links, search, and theme selector on the right -->
        <div class="flex items-center gap-3 sm:gap-6 md:gap-10">
          <!-- Navigation links -->
          <div class="hidden sm:flex items-center gap-6 md:gap-10">
            {%- for entry in collections.all | eleventyNavigation %}
            <a
              href="{{ entry.url | url }}"
              class="uppercase text-base font-ui font-medium text-textBody hover:text-textAccent transition-colors {% if entry.url == page.url %} text-textAccent{% endif %}"
              {% if entry.url == page.url %}aria-current="page"{% endif %}
            >
              {{ entry.title }}
            </a>
            {%- endfor %}
          </div>

          <!-- Search Bar -->
          <form
            class="search flex items-center"
            action="https://www.google.com/search"
            method="GET"
          >
            <input type="hidden" name="sitesearch" value="geshan.com.np" />
            <div class="relative">
              <input
                class="bg-surfaceTag text-textStrong placeholder:text-textMuted border border-borderSubtle rounded-lg py-2 pl-9 pr-3 font-body text-sm focus:outline-none focus:ring-2 focus:ring-borderStrong focus:border-transparent w-32 sm:w-40"
                type="text"
                name="q"
                placeholder="Search"
                aria-label="Search blog"
              />
              <svg
                class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-textMuted"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                />
              </svg>
            </div>
          </form>

          <!-- Theme Selector Toggle -->
          <button
            type="button"
            class="theme-toggle"
            data-theme-toggle
            title="Toggle light/dark theme"
          >
            <span class="theme-toggle-to-dark">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                />
              </svg>
              <span class="sr-only">Switch to dark theme</span>
            </span>
            <span class="theme-toggle-to-light">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                />
              </svg>
              <span class="sr-only">Switch to light theme</span>
            </span>
          </button>

          <!-- Mobile menu button -->
          <button
            type="button"
            class="sm:hidden inline-flex items-center justify-center p-2 rounded-md text-textStrong hover:bg-surfaceTinted focus:outline-none focus:ring-2 focus:ring-inset focus:ring-borderStrong"
            onClick="mobileView()"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <span class="sr-only">Open main menu</span>
            <svg
              class="w-6 h-6"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile menu (overlay) -->
    <div
      id="mobile-menu"
      class="mobile-menu fixed inset-0 z-40 hidden sm:hidden bg-black bg-opacity-50"
      role="dialog"
      aria-modal="true"
    >
      <!-- Clickable backdrop -->
      <div class="absolute inset-0" onClick="mobileView()" aria-hidden="true"></div>

      <!-- Slide-over panel -->
      <div
        class="mobile-menu-panel relative ml-auto flex h-full w-10/12 max-w-sm flex-col justify-start bg-surfaceElevated text-textBody shadow-xl border-l border-borderSubtle"
      >
        <!-- Header -->
        <div class="flex items-center justify-between px-4 py-4 border-b border-borderSubtle">
          <div class="flex items-center gap-3">
            <img class="h-8 w-8" src="/images/theme/new_logo.svg" alt="Geshan G" />
            <span class="text-lg font-semibold text-textStrong font-body">Geshan's Blog</span>
          </div>
          <button
            type="button"
            class="inline-flex items-center justify-center rounded-full p-2 text-textBody hover:bg-surfaceTinted focus:outline-none focus:ring-2 focus:ring-borderStrong"
            onClick="mobileView()"
            aria-label="Close main menu"
          >
            <svg
              class="h-6 w-6"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>

        <!-- Navigation links -->
        <nav class="overflow-y-auto px-4 py-6 space-y-2">
          <a
            href="/"
            class="block rounded-lg px-3 py-2 text-base font-medium font-ui text-textStrong hover:bg-surfaceTinted {% if page.url == '/' %} bg-surfaceTinted{% endif %}"
            {% if page.url == '/' %}aria-current="page"{% endif %}
          >
            Home
          </a>
          {%- for entry in collections.all | eleventyNavigation %}
          <a
            href="{{ entry.url | url }}"
            class="block rounded-lg px-3 py-2 text-base font-medium font-ui text-textStrong hover:bg-surfaceTinted {% if entry.url == page.url %} bg-surfaceTinted{% endif %}"
            {% if entry.url == page.url %}aria-current="page"{% endif %}
          >
            {{ entry.title }}
          </a>
          {%- endfor %}
        </nav>

        <!-- Footer area (optional actions) -->
        <div class="px-4 py-4 border-t border-borderSubtle">
          <a
            href="https://www.linkedin.com/in/geshan"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-lg bg-fillAccent px-4 py-2 text-base font-regular font-body text-textOnAccent hover:opacity-90 transition-opacity w-full text-center"
          >
            Connect on LinkedIn
          </a>
        </div>
      </div>
    </div>
  </nav>
</div>
